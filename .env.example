# Copy to .env and fill in. Never commit .env.
LLM_API_KEY=
POSTGRES_DB=brimap
POSTGRES_USER=brimap
POSTGRES_PASSWORD=brimap
# Secret key for signing the audit log (HMAC). Keep it out of git; whoever holds it is not the database admin.
# After setting or changing it, run scripts/reset-and-seed.sh, or old rows will show as tampered.
AUDIT_HMAC_KEY=