# Copy to .env and fill in. Never commit .env.
LLM_API_KEY=
POSTGRES_DB=brimap
POSTGRES_USER=brimap
POSTGRES_PASSWORD=brimap

# Optional: live AP mailbox over IMAP. Gmail: MAIL_HOST=imap.gmail.com plus an app password.
# Outlook/Microsoft 365: MAIL_HOST=outlook.office365.com (the tenant must allow IMAP).
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=993
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FOLDER=INBOX
MAIL_AUTO_POLL=false
# Secret key for signing the audit log (HMAC). Keep it out of git; whoever holds it is not the database admin.
# After setting or changing it, run scripts/reset-and-seed.sh, or old rows will show as tampered.
AUDIT_HMAC_KEY=
